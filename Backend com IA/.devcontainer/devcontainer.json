{
  "name": ".NET 10 + ASP.NET Core",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp"
      ]
    }
  },

  "forwardPorts": [8080, 3306],
  "portsAttributes": {
    "8080": {
      "label": "ASP.NET Core API",
      "onAutoForward": "notify"
    },
    "3306": {
      "label": "MySQL",
      "onAutoForward": "silent"
    }
  },

  "remoteEnv": {
    "MYSQL_ROOT_PASSWORD": "root",
    "MYSQL_DATABASE": "meetup_db"
  },

  "postCreateCommand": "sudo chown -R vscode:vscode MeetupApi.Web/bin MeetupApi.Web/obj MeetupApi.Tests/bin MeetupApi.Tests/obj && dotnet restore"
}
